{
  "name": "nutrilite",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite --port 3000",
    "build": "vue-tsc -b && vite build && node scripts/build-sw.mjs",
    "serve": "vite preview --port 3000",
    "check:content": "node scripts/check-content.mjs",
    "check:ssr": "node scripts/ssr-check.mjs",
    "check": "npm run check:content && npm run check:ssr"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  }
}
